{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phantom-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    "LLM_CHAIN": "gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b",
    "AGENT_MAX_STEPS": "4",
    "AGENT_DEADLINE_MS": "6000",
    "LLM_ATTEMPT_TIMEOUT_MS": "3000",
    "LLM_COOLDOWN_MS": "60000",
    "FETCH_TIMEOUT_MS": "5000",
    "FETCH_MAX_BYTES": "1048576",
    "CACHE_TTL_DANGER_DAYS": "14",
    "CACHE_TTL_NEUTRAL_DAYS": "3",
    "RATE_LIMIT_ANALYZE_PER_MIN": "30",
    "RATE_LIMIT_CHECK_PER_MIN": "6",
    "ALLOWED_ORIGINS": "https://phantom-web.vercel.app",
    "ALLOW_EXTENSION_ORIGINS": "true"
  },
  "kv_namespaces": [
    {
      "binding": "PHANTOM_CACHE",
      "id": "4cdbc014301a4335a97873b9776d7f88"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_ANALYZE",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_CHECK",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
