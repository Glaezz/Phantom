# Kosongkan bila memakai proxy same-origin Vite (/api -> http://127.0.0.1:8787).
# Isi hanya bila Web Cek memanggil worker langsung, mis. http://127.0.0.1:8787.
VITE_PROXY_API_URL=

# Target proxy Vite untuk dev/preview (opsional, default http://127.0.0.1:8787).
VITE_PROXY_TARGET=http://127.0.0.1:8787

# true = lewati jaringan dan pakai pemeriksaan L0/L1 lokal saja (tanpa fixture).
VITE_USE_MOCK=false
